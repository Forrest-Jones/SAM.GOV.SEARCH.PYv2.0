{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt -r webapp/requirements.txt"
  },
  "deploy": {
    "startCommand": "gunicorn --chdir webapp app:app --bind 0.0.0.0:$PORT --timeout 300",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE"
  }
}
